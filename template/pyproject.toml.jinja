[project]
name = "{{ project_name|lower|replace('_', '-')|replace(' ', '-') }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
requires-python = ">={{ python_version }}"
dependencies = [
    "alembic>=1.16.4",
    "asyncpg>=0.30.0",
    "fastapi>=0.116.0",
    "httpx>=0.28.1",
    "pydantic-settings>=2.12.0",
    "pyjwt[crypto]>=2.12.1",
    "sqlalchemy>=2.0.42",
    "uvicorn>=0.35.0",
]

[dependency-groups]
dev = [
    "ipykernel>=6.31.0",
    "mypy>=1.19.1",
    "ruff>=0.14.10",
    {%- if add_pre_commit %}
    "pre-commit>=4.5.1",
    {%- endif %}
]

[tool.ruff]
line-length = 79
indent-width = 4
include = ["**.py", "*.ipynb"]

[tool.ruff.lint]
select = [
    "E",
    "W",
    "F",
    "I",
    "B",
    "PTH",
    "ANN",
    "ARG",
]

[tool.mypy]
files = ["app"]
python_version = "{{ python_version }}"
check_untyped_defs = true
ignore_missing_imports = true
no_implicit_optional = true
